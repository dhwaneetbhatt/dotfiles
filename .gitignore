nvim/.config/nvim/lazy-lock.json

# herdr: only config.toml and CHEATSHEET.md are tracked; everything else under
# ~/.config/herdr is live runtime state (sockets, logs, session snapshots) and
# must stay local.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/CHEATSHEET.md
