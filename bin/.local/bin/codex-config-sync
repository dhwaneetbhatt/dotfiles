#!/usr/bin/env python3
"""codex-config-sync

Idempotently merge the durable Codex settings tracked in dotfiles
(codex/.codex/config.fragment.toml) into the live ~/.codex/config.toml,
WITHOUT clobbering the runtime state Codex owns and rewrites (TUI nux
counters, [hooks.state] trusted hashes, plugin/marketplace state, personal
model choice, ...).

Why a merge script instead of a stow symlink:
  Codex continuously rewrites ~/.codex/config.toml at runtime, with
  machine-specific absolute paths. Symlinking the whole file into the repo
  would churn git and could break the symlink if Codex writes via atomic
  rename. So we track only the hand-authored settings as a fragment and
  reconcile them here.

Behaviour:
  * Each top-level table in the fragment is ensured in the live config.
  * A table already present with identical content is left untouched (no-op,
    so this is safe to run on every bootstrap).
  * A table present but differing is replaced in place.
  * A missing table is appended.
  * Top-level scalar keys in the fragment (outside any table) are ensured too.
  * The result is re-parsed to guarantee we never write invalid TOML; on any
    parse failure the original file is left untouched.

Usage:
  codex-config-sync [--dry-run] [--fragment PATH] [--config PATH]

Exit codes: 0 = in sync / applied, 1 = error.
"""
from __future__ import annotations

import argparse
import os
import re
import sys
import tomllib
from pathlib import Path


def parse(path: Path) -> dict:
    with path.open("rb") as fh:
        return tomllib.load(fh)


def table_block(name: str, body_lines: list[str]) -> str:
    """Render a single [name] table from the fragment's raw lines."""
    return f"[{name}]\n" + "".join(body_lines)


def split_fragment(text: str):
    """Return (scalars_text, {table_name: raw_block_text}) from fragment text.

    Comments and blank lines attached above a table header are dropped from the
    merged output on purpose: the live file is machine-managed and we only want
    the effective settings there. The human-facing docs live in the fragment.
    """
    lines = text.splitlines(keepends=True)
    scalars: list[str] = []
    tables: dict[str, list[str]] = {}
    current: str | None = None
    header_re = re.compile(r"^\[([^\]]+)\]\s*$")
    for line in lines:
        stripped = line.strip()
        m = header_re.match(line.rstrip("\n"))
        if m:
            current = m.group(1)
            tables.setdefault(current, [])
            continue
        if current is None:
            # Top-level region: keep only real key = value lines.
            if stripped and not stripped.startswith("#"):
                scalars.append(line if line.endswith("\n") else line + "\n")
        else:
            if stripped.startswith("#"):
                continue
            tables[current].append(line if line.endswith("\n") else line + "\n")
    return scalars, tables


def find_table_span(config_text: str, name: str):
    """Return (start, end) line indices of [name] ... block in config_text, or None."""
    lines = config_text.splitlines(keepends=True)
    header = f"[{name}]"
    header_re = re.compile(r"^\[[^\]]+\]\s*$")
    start = None
    for i, line in enumerate(lines):
        if line.rstrip("\n").strip() == header:
            start = i
            break
    if start is None:
        return None
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if header_re.match(lines[j].rstrip("\n")):
            end = j
            break
    return start, end


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--fragment")
    ap.add_argument("--config")
    args = ap.parse_args()

    # Default locations relative to this script's dotfiles layout.
    home = Path(os.path.expanduser("~"))
    config_path = Path(args.config) if args.config else home / ".codex" / "config.toml"
    if args.fragment:
        fragment_path = Path(args.fragment)
    else:
        # bin/.local/bin/codex-config-sync -> repo_root is three parents up.
        repo_root = Path(__file__).resolve().parents[3]
        fragment_path = repo_root / "codex" / ".codex" / "config.fragment.toml"

    if not fragment_path.is_file():
        print(f"fragment not found: {fragment_path}", file=sys.stderr)
        return 1

    fragment_text = fragment_path.read_text()
    try:
        fragment_data = parse(fragment_path)
    except tomllib.TOMLDecodeError as exc:
        print(f"fragment is invalid TOML: {exc}", file=sys.stderr)
        return 1

    config_path.parent.mkdir(parents=True, exist_ok=True)
    if config_path.exists():
        config_text = config_path.read_text()
        try:
            config_data = parse(config_path)
        except tomllib.TOMLDecodeError as exc:
            print(f"live config is invalid TOML, refusing to edit: {exc}", file=sys.stderr)
            return 1
    else:
        config_text = ""
        config_data = {}

    scalar_lines, frag_tables = split_fragment(fragment_text)

    # Fast path: already in sync? Compare parsed values for the fragment keys.
    def subset_matches() -> bool:
        for k, v in fragment_data.items():
            if config_data.get(k) != v:
                return False
        return True

    if subset_matches():
        print("codex config already in sync")
        return 0

    new_text = config_text if config_text.endswith("\n") or config_text == "" else config_text + "\n"

    # Ensure top-level scalars (e.g. nothing today, but future-proof).
    for sline in scalar_lines:
        key = sline.split("=", 1)[0].strip()
        key_re = re.compile(rf"^{re.escape(key)}\s*=", re.M)
        if key_re.search(new_text):
            new_text = key_re.sub(sline.rstrip("\n"), new_text, count=1)
        else:
            new_text = sline + new_text  # scalars must precede any table

    # Ensure each fragment table.
    for name, body in frag_tables.items():
        block = table_block(name, body)
        if not block.endswith("\n"):
            block += "\n"
        span = find_table_span(new_text, name)
        lines = new_text.splitlines(keepends=True)
        if span is None:
            if new_text and not new_text.endswith("\n"):
                new_text += "\n"
            if new_text and not new_text.endswith("\n\n"):
                new_text += "\n"
            new_text += block
        else:
            start, end = span
            new_text = "".join(lines[:start]) + block + "".join(lines[end:])

    # Validate before writing.
    try:
        tomllib.loads(new_text)
    except tomllib.TOMLDecodeError as exc:
        print(f"merge would produce invalid TOML, aborting: {exc}", file=sys.stderr)
        return 1

    if args.dry_run:
        print("--- would write ~/.codex/config.toml with these fragment settings merged ---")
        for name in frag_tables:
            print(f"  [{name}]")
        for sline in scalar_lines:
            print(f"  {sline.strip()}")
        return 0

    config_path.write_text(new_text)
    try:
        config_path.chmod(0o600)
    except OSError:
        pass
    print(f"merged dotfiles Codex settings into {config_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
